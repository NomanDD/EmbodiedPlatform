<mujoco model="tracked_robot_world">
  <compiler angle="radian" coordinate="local"/>
  
  <option timestep="0.002" gravity="0 0 -9.81" integrator="Euler"/>

  <asset>
    <texture type="2d" name="grid" builtin="checker" rgb1="0.4 0.5 0.4" rgb2="0.5 0.6 0.5" width="512" height="512"/>
    <material name="grid_mat" texture="grid" texrepeat="8 8" reflectance="0.1"/>
    <material name="robot_mat" rgba="0.2 0.6 0.8 1"/>
    <material name="track_mat" rgba="0.15 0.15 0.15 1"/>
    <material name="wheel_mat" rgba="0.25 0.25 0.25 1"/>
    <material name="wall_mat" rgba="0.6 0.4 0.2 1"/>
    <material name="tower_mat" rgba="0.3 0.3 0.3 1"/>
  </asset>

  <worldbody>
    <geom name="ground" type="plane" size="20 20 0.1" material="grid_mat"/>
    
    <geom name="wall_px" type="box" pos="10 0 0.5" size="0.05 10 0.5" material="wall_mat" mass="100"/>
    <geom name="wall_nx" type="box" pos="-10 0 0.5" size="0.05 10 0.5" material="wall_mat" mass="100"/>
    <geom name="wall_py" type="box" pos="0 10 0.5" size="10 0.05 0.5" material="wall_mat" mass="100"/>
    <geom name="wall_ny" type="box" pos="0 -10 0.5" size="10 0.05 0.5" material="wall_mat" mass="100"/>
    
    <light name="light" pos="0 0 4" dir="0 0 -1" diffuse="0.8 0.8 0.8" ambient="0.3 0.3 0.3"/>
    <light name="light2" pos="3 3 2" dir="-1 -1 -1" diffuse="0.4 0.4 0.4"/>
    
    <body name="base" pos="0 0 0.25">
      <freejoint name="base_joint"/>
      <geom name="body" type="box" size="0.3 0.2 0.1" material="robot_mat" mass="5" condim="4" friction="1.5 0.5 0.01"/>
      
      <geom name="left_track" type="box" pos="0 0.22 0" size="0.3 0.04 0.06" material="track_mat" mass="1"/>
      <geom name="right_track" type="box" pos="0 -0.22 0" size="0.3 0.04 0.06" material="track_mat" mass="1"/>
      
      <geom name="lf_wheel" type="cylinder" pos="0.2 0.22 -0.05" size="0.05 0.02" material="wheel_mat" mass="0.3"/>
      <geom name="lr_wheel" type="cylinder" pos="-0.2 0.22 -0.05" size="0.05 0.02" material="wheel_mat" mass="0.3"/>
      <geom name="rf_wheel" type="cylinder" pos="0.2 -0.22 -0.05" size="0.05 0.02" material="wheel_mat" mass="0.3"/>
      <geom name="rr_wheel" type="cylinder" pos="-0.2 -0.22 -0.05" size="0.05 0.02" material="wheel_mat" mass="0.3"/>
      
      <body name="tower" pos="0 0 0.15">
        <geom name="tower_geom" type="cylinder" size="0.04 0.08" material="tower_mat" mass="0.3"/>
        <geom name="sensor_ball" type="sphere" size="0.025" rgba="1 0.2 0.2 1" pos="0 0 0.08"/>
      </body>
    </body>
  </worldbody>
</mujoco>